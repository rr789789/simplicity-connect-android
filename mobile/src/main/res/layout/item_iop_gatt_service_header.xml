<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tv_service_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/stolzl_medium"
        android:textColor="@color/silabs_redtheme_header_text_color"
        android:textSize="15sp"
        tools:text="IOP Test Service" />

    <TextView
        android:id="@+id/tv_service_uuid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/stolzl_regular"
        android:textColor="@color/silabs_redtheme_body_text_color"
        android:textSize="11sp"
        tools:text="6A2857FE-9092-4E97-8AAE-C028E5B361A8" />

</LinearLayout>
